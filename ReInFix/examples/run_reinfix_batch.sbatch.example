#!/bin/bash
#SBATCH -A pi_juanzhai_umass_edu
#SBATCH --partition=superpod-a100
#SBATCH --gres=gpu:a100:1
#SBATCH --cpus-per-task=32
#SBATCH --mem=256G
#SBATCH --time=2-00:00:00
#SBATCH -o /project/pi_juanzhai_umass_edu/spec-repair-test/logs/%x-%j.out
#SBATCH -e /project/pi_juanzhai_umass_edu/spec-repair-test/logs/%x-%j.err

set -euo pipefail

PROJECT_BASE="/project/pi_juanzhai_umass_edu/spec-repair-test"
REINFIX_DIR="${PROJECT_BASE}/ReInFix"
REPAIRAGENT_SRC="${PROJECT_BASE}/repair_agent"

mkdir -p "${PROJECT_BASE}/logs"

export REPAIRAGENT_SRC
export REPAIRAGENT_ROOT="${REPAIRAGENT_SRC}"
export OPENAI_API_KEY="YOUR_KEY_HERE"
export OPENAI_API_BASE_URL="https://bedrock-mantle.us-east-2.api.aws/v1"
export OPENAI_API_BASE="https://bedrock-mantle.us-east-2.api.aws/v1"

# Prefer the maintained script:
#   ./scripts/setup_cluster_env.sh          # one-time setup
#   sbatch examples/run_reinfix_spec.sbatch # ReInFix+spec batch (starts Joern/RAG in-job)
#
# Baseline comparison:
#   REINFIX_MODE=baseline sbatch examples/run_reinfix_spec.sbatch

sbatch examples/run_reinfix_spec.sbatch
